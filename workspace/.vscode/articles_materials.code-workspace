{
	"folders": [
		{
			"path": ".."
		},
		{
			"path": "../../embeddings_comparison"
		},
		{
			"path": "../../wikiparser"
		},
		{
			"path": "../../utils"
		}
	],
	"settings": {
		// Python settings
		"python.analysis.autoSearchPaths": true,
		"python.analysis.diagnosticSeverityOverrides": {
			"reportMissingImports": "none",
		},
		"python.envFile": "${workspaceFolder}/.env",
		"python.analysis.typeCheckingMode": "standard",
		"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
		// Editor settings
		"ruff.importStrategy": "useBundled",
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.formatOnSave": true,
		"editor.formatOnPaste": true,
		"editor.formatOnSaveMode": "file",
		"editor.codeActionsOnSave": {
			"source.organizeImports": "always",
			"source.unusedImports": "always",
			"source.fixAll": "always"
		},
		"files.autoSave": "onFocusChange",
		// Test settings
		"python.testing.pytestEnabled": true,
		"python.testing.unittestEnabled": false,
		"python.testing.autoTestDiscoverOnSaveEnabled": false,
		"python.analysis.extraPaths": [
			"${workspaceFolder}/src"
		],
		// Debugging settings
		"debugpy.debugJustMyCode": false,
		"jupyter.debugJustMyCode": false,
		// Terminal settings (to load .env in shell and fix .bashrc by removing conda init for this project)
		"python.terminal.shellIntegration.enabled": true,
		"terminal.integrated.accessibleViewPreserveCursorPosition": false,
		"terminal.integrated.profiles.linux": {
			"BashWithStartup": {
				"path": "bash",
				"args": [
					"--init-file",
					"${workspaceFolder}/.bashrc"
				],
				"color": "terminal.ansiBlue"
			}
		},
		"terminal.integrated.defaultProfile.linux": "BashWithStartup",
		"jupyter.notebookFileRoot": "${workspaceFolder}"
	}
}